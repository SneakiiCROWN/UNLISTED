extends "res://scripts/maintenance_qa.gd"
func play_store() -> void:
	await super.play_store()
	await travel(Vector2(3.25,-16.1),"return to inspection passage")
	await travel(Vector2(3.25,-12.6),"find return inspection box",false,true)
	g.player.camera.look_at(g.witness.global_position);await wait(.2);await shot("W01_captive_cover")
	await use("witness_cover")
	check("fasteners actually retain cover",not g.events.get("witness_open",false))
	await use("witness_fastener0");g.save_game();g.load_game();await wait(.2)
	check("one released fastener survives save",g.events.witness_fasteners==[true,false] and not g.events.get("witness_open",false))
	await use("witness_cover")
	check("one retained fastener still prevents opening",not g.events.get("witness_open",false))
	await use("witness_fastener1");await use("witness_cover")
	await action("ui_cancel");var slide: float=g.witness.cover.position.x;await wait(.3)
	check("pause freezes captive cover",g.menu_open and is_equal_approx(slide,g.witness.cover.position.x))
	g.presentation.buttons.Resume.pressed.emit();g.save_game()
	slide=float(JSON.parse_string(FileAccess.get_file_as_string(g.checkpoint_path)).events.witness_slide);g.load_game()
	check("mid-slide cover restores serialized position before resumed motion",absf(g.witness.cover.position.x-slide)<.016,"saved="+str(slide)+" restored="+str(g.witness.cover.position.x));await wait(.1)
	await wait(1.6);g.player.camera.look_at(g.targets.witness_carbon.global_position);await shot("W02_unsigned_carbon")
	await use("witness_carbon",false)
	check("physical unsigned carbon is retained",g.events.get("witness_carbon_read",false) and g.events.notes.has(g.NOTES.WITNESS_TITLE) and g.presentation.note.text.contains("Witness signature: [blank]"))
	check("reading does not play an unseen event during pause",g.witness.emitted.is_empty() and g.events.get("witness_echo_pending",false))
	await shot("W03_clearance_evidence");await action("ui_cancel")
	var remote_memory: bool=g.impossible_room.active
	await travel(Vector2(3.25,-11.5),"footstep follows physical crawl",false,true)
	if remote_memory:check("upstairs room memory does not suppress below-ground event",g.impossible_room.active and g.witness.emitted.size()>0)
	check("movement produces a real overhead cue",g.witness.emitted.size()>0 and int(g.events.get("witness_steps",0))>0)
	await action("ui_cancel");var count: int=int(g.events.get("witness_steps",0));await wait(.5)
	check("pause freezes following sounds",int(g.events.get("witness_steps",0))==count)
	g.presentation.buttons.Resume.pressed.emit();g.save_game();g.load_game();await wait(.2)
	check("saved sound stage does not replay on load",int(g.events.get("witness_steps",0))==count and g.witness.emitted.is_empty())
	await travel(Vector2(3.25,-14.5),"return crawl beneath answering footsteps",false,true)
	g.player.camera.look_at(g.witness.global_position);await wait(1.8)
	check("extra step continues after player stops",g.events.get("witness_echo_done",false) and int(g.events.get("witness_steps",0))==3)
	check("watched cover is not closed for a scare",g.events.get("witness_open",false) and g.witness.cover.position.x<-.66)
	g.player.camera.look_at(Vector3(3.25,-2,-16));await wait(2)
	check("unseen cover returns along its real rails",not g.events.get("witness_open",true) and absf(g.witness.cover.position.x)<.02)
	g.save_game();g.load_game();await wait(.2)
	check("evidence and consumed event survive reload",g.events.get("witness_carbon_read",false) and g.events.get("witness_echo_done",false) and not g.witness.paper.visible)
	await travel(Vector2(3.25,-16.1),"new discovery preserves cellar return",false,true);await wait(.2)
	check("standing recovery remains valid",not g.player.crouched and g.player.can_stand())
	await travel(Vector2(0,-18),"inspection evidence rejoins relay route")
