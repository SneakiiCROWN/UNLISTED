extends "res://scripts/witness_carbon_qa.gd"
# Continuous-route helper. No new item awards, relocations, prop staging or AI states.
func play_store() -> void:
	await super.play_store()
	await travel(Vector2(0,-7),"service discovery returns by original cellar ramp")
	await travel(Vector2(-3.1,-7),"investigation through utility aisle")
	await travel(Vector2(-4.5,-8.6),"original service door approach")
	await travel(Vector2(-4.5,-12.5),"original yard threshold")
	await travel(Vector2(9,-12.5),"follow rear property around house")
	await travel(Vector2(13.7,-12.5),"east garden approach")
	await travel(Vector2(13.25,-8.35),"discover service grille from property")
	g.player.camera.look_at(Vector3(9.5,.2,-8.35));await shot("X01_exterior_bulkhead")
	await use("exit_outer_handle");await wait(1.4)
	check("fresh route exterior release creates no false departure",g.events.get("exit_open",false) and not g.events.get("exit_false_departure",false))
	await travel(Vector2(12,-8.35),"service landing from actual yard")
	await travel(Vector2(10.25,-8.35),"investigate inside real service incline",false,true)
	await use("exit_grille");await wait(1.5)
	check("grille closes from below without blocking player",absf(g.service_exit.grille.rotation.y)<.02)
	await use("exit_grille");await wait(1.5)
	check("fresh investigation witnesses impossible departure before crossing",g.events.get("exit_false_departure",false) and g.player.position.x<11)
	g.player.camera.look_at(Vector3(11.8,.6,-8.35));await shot("X03_open_return")
	await travel(Vector2(5,-8.35),"new service route reconnects original records store",false,true)
	await wait(.3);check("normal standing resumes in records aisle",not g.player.crouched and g.player.can_stand())
	await travel(Vector2(5,-9.6),"follow real return wire to existing terminal")
	await use("exit_receipt",false)
	check("new contact evidence earned without awarding older clues",g.events.get("exit_receipt_read",false) and g.events.get("witness_carbon_read",false) and not g.events.get("line_strip_read",false) and not g.events.get("memory_confirmed",false))
	await shot("X04_false_departure_evidence");await action("ui_cancel");await wait(.4)
	check("continuous discovery starts local search",g.events.get("exit_blackout_running",false) and g.threat.active() and g.events.threat_origin=="service_exit")
	await wait(2);g.player.camera.look_at(Vector3(3.25,-2,-10.4));await shot("X05_blackout_store")
	await travel(Vector2(5,-8.35),"blackout escape along existing records aisle")
	await travel(Vector2(12.2,-8.35),"real crouched escape through service exit",false,true)
	await travel(Vector2(13.7,-8.35),"new escape reaches open property")
	for i in 200:
		if g.events.get("exit_blackout_done",false):break
		await wait(.15)
	check("local search ends without consuming original relay encounter",g.events.get("exit_blackout_done",false) and not g.events.get("threat_resolved",true) and not g.threat.active() and not g.events.get("threat_pending",true))
	g.save_game();g.load_game();await wait(.3)
	check("continuous outside checkpoint retains both physical discoveries",g.events.get("exit_receipt_read",false) and g.events.get("witness_carbon_read",false) and g.events.get("exit_blackout_done",false))
	g.player.camera.look_at(Vector3(9.5,.3,-8.35));await shot("X06_yard_escape")
	await travel(Vector2(12,-8.35),"return through new threshold")
	await travel(Vector2(5,-8.35),"new return preserves physical cellar connection",false,true)
	await travel(Vector2(3.25,-9.3),"rejoin original records aisle")
	await travel(Vector2(3.25,-12.8),"old crawl remains accessible",false,true)
	await travel(Vector2(3.25,-16.1),"service investigation returns to relay",false,true)
	await travel(Vector2(0,-18),"new evidence rejoins existing isolation progression")
